{
  "name": "settimes",
  "version": "1.0.0",
  "engines": {
    "node": ">=20.11"
  },
  "type": "module",
  "description": "SetTimes.ca - Event Schedule & Performance Management Platform",
  "scripts": {
    "pages:dev": "./frontend/node_modules/.bin/wrangler pages dev frontend/dist --port 8788 --persist-to .wrangler/state --binding ENVIRONMENT=development",
    "pages:dev:public": "npm run pages:dev -- --binding PUBLIC_DATA_PUBLISH_ENABLED=true",
    "migrate:local": "bash scripts/migrate-local-db.sh",
    "validate:schema": "node scripts/validate-db-schema.js",
    "validate:openapi": "node scripts/validate-openapi.mjs",
    "verify:schema:remote": "node scripts/verify-remote-d1-schema.mjs",
    "deploy:dev": "npm --prefix frontend run build && ./frontend/node_modules/.bin/wrangler pages deploy frontend/dist --project-name settimesdotca --branch dev",
    "deploy:prod": "npm --prefix frontend run build && ./frontend/node_modules/.bin/wrangler pages deploy frontend/dist --project-name settimesdotca --branch main",
    "prebuild": "npm run validate:schema",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"functions/**/*.{js,json}\" \"scripts/**/*.{js,mjs,json}\" \"e2e/**/*.{js,mjs}\"",
    "format:check": "prettier --check \"functions/**/*.{js,json}\" \"scripts/**/*.{js,mjs,json}\" \"e2e/**/*.{js,mjs}\"",
    "lint": "eslint functions/ scripts/ e2e/ --max-warnings 0",
    "lint:md": "npx -y markdownlint-cli2@0.23.2 \"**/*.md\""
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.11",
    "acorn": "^8.18.0",
    "baseline-browser-mapping": "^2.11.20",
    "better-sqlite3": "^13.0.3",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "csrf-csrf": "^4.0.3",
    "email-validator": "^2.0.4"
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.18"
  }
}
